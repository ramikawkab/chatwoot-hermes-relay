# Set these in Coolify -> your relay app -> Environment Variables (NOT in GitHub)
CHATWOOT_URL=https://your-chatwoot-domain
CHATWOOT_BOT_TOKEN=bot-access-token-from-chatwoot
CHATWOOT_WEBHOOK_SECRET=webhook-secret-from-chatwoot
HERMES_API_URL=http://hermes-internal-address:8642
HERMES_API_KEY=your-hermes-API_SERVER_KEY
# Voice notes are turned into text by OpenAI. Without this key they get VOICE_ERROR_MESSAGE.
OPENAI_API_KEY=sk-...
# Optional
# SYSTEM_PROMPT=Describe your business and how the agent should answer (the photo and voice rules are always added)
# HANDOFF_KEYWORDS=human,real person,agent,representative
# HANDOFF_MESSAGE=...
# ATTACHMENT_MESSAGE=...            reply to a file the relay can't read (video, document)
# VOICE_ERROR_MESSAGE=...           reply when a voice note can't be turned into text
# BATCH_SECONDS=5                   wait this long for more messages before answering
# MAX_IMAGE_MB=5                    largest photo the relay passes on or sends
# TRANSCRIBE_MODEL=gpt-4o-transcribe
# TRANSCRIBE_PROMPT=...             hint for the transcription (languages, topic)
